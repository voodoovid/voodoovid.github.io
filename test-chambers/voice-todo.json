[
 {
  "hash": "18f4a69f",
  "chamber": 0,
  "text": "Rude.",
  "voice": "sentry"
 },
 {
  "hash": "83f32433",
  "chamber": 0,
  "text": "I regret nothing!",
  "voice": "sentry"
 },
 {
  "hash": "f8907d3d",
  "chamber": 0,
  "text": "Tell the others I fought bravely. Mostly.",
  "voice": "sentry"
 },
 {
  "hash": "d28b0e35",
  "chamber": 0,
  "text": "Not the face!",
  "voice": "sentry"
 },
 {
  "hash": "0a542c52",
  "chamber": 0,
  "text": "Worth it.",
  "voice": "sentry"
 },
 {
  "hash": "7bf83e0f",
  "chamber": 0,
  "text": "This is fine. This is fine.",
  "voice": "sentry"
 },
 {
  "hash": "9827a6f5",
  "chamber": 0,
  "text": "I was two days from retirement.",
  "voice": "sentry"
 },
 {
  "hash": "87c360f5",
  "chamber": 0,
  "text": "Remember me as a hero.",
  "voice": "sentry"
 },
 {
  "hash": "1068a74b",
  "chamber": 0,
  "text": "You'll miss me.",
  "voice": "sentry"
 },
 {
  "hash": "84995022",
  "chamber": 0,
  "text": "Low battery. Story of my life.",
  "voice": "sentry"
 },
 {
  "hash": "570384f6",
  "chamber": 0,
  "text": "Oh, come on!",
  "voice": "sentry"
 },
 {
  "hash": "ed0e983b",
  "chamber": 0,
  "text": "I was almost a coffee machine.",
  "voice": "sentry"
 },
 {
  "hash": "02987b67",
  "chamber": 0,
  "text": "Everything is sideways now.",
  "voice": "sentry"
 },
 {
  "hash": "8fa0d33e",
  "chamber": 0,
  "text": "Wheee! Wait. Where am I?",
  "voice": "sentry"
 },
 {
  "hash": "fd4a3ae6",
  "chamber": 0,
  "text": "That floor was not there before!",
  "voice": "sentry"
 },
 {
  "hash": "2204b1bb",
  "chamber": 0,
  "text": "Who moved the room?",
  "voice": "sentry"
 },
 {
  "hash": "76919e31",
  "chamber": 0,
  "text": "Falling is my least favourite direction.",
  "voice": "sentry"
 },
 {
  "hash": "99699611",
  "chamber": 0,
  "text": "Hit by a box. How embarrassing.",
  "voice": "sentry"
 },
 {
  "hash": "c7bb54c3",
  "chamber": 0,
  "text": "The cube! It's always the cube!",
  "voice": "sentry"
 },
 {
  "hash": "5cb28061",
  "chamber": 0,
  "text": "I didn't even see it coming.",
  "voice": "sentry"
 },
 {
  "hash": "65e4630a",
  "chamber": 0,
  "text": "Hey! No pushing!",
  "voice": "sentry"
 },
 {
  "hash": "cb7a2f68",
  "chamber": 0,
  "text": "Who's there? Oh no.",
  "voice": "sentry"
 },
 {
  "hash": "802b6822",
  "chamber": 0,
  "text": "That's cheating!",
  "voice": "sentry"
 },
 {
  "hash": "23161145",
  "chamber": 0,
  "text": "Eyes in the back of my head. I should have ordered those.",
  "voice": "sentry"
 },
 {
  "hash": "e551d2ce",
  "chamber": 0,
  "text": "Hey! Hands off!",
  "voice": "sentry"
 },
 {
  "hash": "46a3eb08",
  "chamber": 0,
  "text": "Personal space, please!",
  "voice": "sentry"
 },
 {
  "hash": "c23dda98",
  "chamber": 0,
  "text": "Put me down! Oh. You did.",
  "voice": "sentry"
 }
]
