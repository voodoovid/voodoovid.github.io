[
 {
  "hash": "d4b43295",
  "chamber": 32,
  "text": "Welcome back to Hold Music, the show where you're on hold. I'm Ted.",
  "voice": "ted"
 },
 {
  "hash": "37804f3f",
  "chamber": 32,
  "text": "I'm Lint. I'm a sock.",
  "voice": "lint"
 },
 {
  "hash": "07bea860",
  "chamber": 32,
  "text": "We're both socks, Lint.",
  "voice": "ted"
 },
 {
  "hash": "1889f9f3",
  "chamber": 32,
  "text": "I'm more of a sock.",
  "voice": "lint"
 },
 {
  "hash": "87e644da",
  "chamber": 32,
  "text": "First caller's been holding for... forty-one years. Go ahead.",
  "voice": "ted"
 },
 {
  "hash": "3d4a597f",
  "chamber": 32,
  "text": "That was the lift.",
  "voice": "lint"
 },
 {
  "hash": "0909f13e",
  "chamber": 32,
  "text": "The lift doesn't call in.",
  "voice": "ted"
 },
 {
  "hash": "fb0266db",
  "chamber": 32,
  "text": "It calls up. And down.",
  "voice": "lint"
 },
 {
  "hash": "6a77e957",
  "chamber": 32,
  "text": "Tonight: the delivery. A courier got into the facility and won't sign for anything.",
  "voice": "ted"
 },
 {
  "hash": "d580a4cb",
  "chamber": 32,
  "text": "SaDos says it's not a courier. It's a test subject that arrived pre-packaged.",
  "voice": "lint"
 },
 {
  "hash": "1f532099",
  "chamber": 32,
  "text": "Question for SaDos?",
  "voice": "ted"
 },
 {
  "hash": "b52e802b",
  "chamber": 32,
  "text": "Where do the cubes go when they fizzle?",
  "voice": "lint"
 },
 {
  "hash": "6d56630b",
  "chamber": 32,
  "text": "Lost and found. Room 37.",
  "voice": "ted"
 },
 {
  "hash": "8ba852a0",
  "chamber": 32,
  "text": "Nobody's ever come back from Room 37.",
  "voice": "lint"
 },
 {
  "hash": "f3714109",
  "chamber": 32,
  "text": "That's how you know it's lost.",
  "voice": "ted"
 },
 {
  "hash": "914e665f",
  "chamber": 32,
  "text": "This program is not approved. Neither are you."
 },
 {
  "hash": "32329bd9",
  "chamber": 32,
  "text": "She's a fan.",
  "voice": "ted"
 },
 {
  "hash": "1b36c6ad",
  "chamber": 32,
  "text": "If you're watching this, you're not solving a puzzle.",
  "voice": "lint"
 },
 {
  "hash": "fc050ce1",
  "chamber": 32,
  "text": "She can see you, you know.",
  "voice": "ted"
 },
 {
  "hash": "7e64046e",
  "chamber": 32,
  "text": "Who, me?",
  "voice": "lint"
 },
 {
  "hash": "14c0668d",
  "chamber": 32,
  "text": "Not you.",
  "voice": "ted"
 },
 {
  "hash": "47a0ac1f",
  "chamber": 32,
  "text": "Ow.",
  "voice": "lint"
 },
 {
  "hash": "0146133a",
  "chamber": 32,
  "text": "We'll be right back. We won't. It's just a thing we say.",
  "voice": "ted"
 }
]